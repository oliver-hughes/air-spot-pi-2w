# GENERATED by air-spot-pi-2w bootstrap. Local edits will be overwritten.
#
# Installed to /etc/camillagui.yml and passed to the backend with -c.
#
# The bundled executable's own config lives at _internal/config/camillagui.yml
# inside /opt/camillagui. We deliberately don't write there: that directory is
# replaced wholesale on a version bump, so any edit would silently vanish.
#
# Every field below is a real one. An earlier revision invented several
# (`active_config`, `update_config_symlink`, `update_config_txt`) and, worse,
# put the file where the backend never looks -- so the whole thing was ignored
# and it fell back to ~/camilladsp/... paths under a home directory that
# doesn't exist for the service user.

camilla_host: "127.0.0.1"
camilla_port: 1234

# Exposed on the LAN with no authentication -- this is a home network and
# needing an SSH tunnel to nudge an EQ band is friction you'd stop tolerating
# within a week. Set bind_address to 127.0.0.1 and tunnel to lock it down.
bind_address: "@GUI_BIND@"
port: @GUI_PORT@

ssl_certificate: null
ssl_private_key: null
gui_config_file: null

config_dir: "/etc/camilladsp/configs"
coeff_dir: "/etc/camilladsp/coeffs"
default_config: "/etc/camilladsp/configs/active.yml"

# Must match camilladsp.service's --statefile. This is how the GUI knows which
# config is live and what the volume is; point it elsewhere and the GUI shows
# stale state while appearing to work.
statefile_path: "/var/lib/camilladsp/statefile.yml"

# CamillaDSP logs to the journal here, not to a file -- `journalctl -u camilladsp`.
log_file: null

on_set_active_config: null
on_get_active_config: null

# This build only ever uses ALSA. Constraining the lists keeps the GUI's device
# pickers from offering backends that aren't compiled in.
supported_capture_types: ["Alsa"]
supported_playback_types: ["Alsa"]
