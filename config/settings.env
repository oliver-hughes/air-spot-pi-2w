# Site settings. Change here, then: sudo ./bootstrap.sh --reconfigure
#
# For the EQ itself, see config/camilladsp/filters.yml.

# Hostname and the name that appears in the AirPlay picker.
AIRPLAY_NAME="big"

# ---------------------------------------------------------------------------
# Sample rate. Read the note before changing this.
# ---------------------------------------------------------------------------
# The ALSA loopback adopts the rate of whichever application opens it first, so
# shairport-sync and CamillaDSP must be pinned to the same value. This variable
# sets both.
#
# 48000 is correct for AirPlay 2. The format tiers shairport-sync 5.x can
# receive are:
#
#     Basic      ALAC/S16/44100/2   (realtime)
#                AAC/F24/44100/2    (buffered)
#     Better     AAC/F24/48000/2
#     Lossless   ALAC/S24/48000/2   <-- 48k only
#     Surround   AAC/F24/48000/5.1, 7.1
#
# There is no 44.1 lossless tier. Lossless over AirPlay 2 *is* 24-bit/48k, so
# pinning 44100 would downsample the best stream your senders can produce.
#
# The cost of 48000 is that the two Basic-tier 44.1 formats get upsampled by
# shairport-sync on the way in. That's the lowest-quality tier anyway, and
# shairport-sync 5's "vernier" resampler exists specifically for low-power CPUs.
#
# If you ever want zero resampling at either rate, that needs
# camilladsp-controller to follow the rate dynamically -- see DESIGN.md 3.2.
OUTPUT_RATE=48000

# S32 carries the S24 lossless tier without truncation, and costs nothing.
OUTPUT_FORMAT="S32"

# ---------------------------------------------------------------------------
# Volume
# ---------------------------------------------------------------------------
# "yes"  -> shairport-sync passes full scale; CamillaDSP owns all attenuation.
#           This is what makes the loudness curve track the real listening
#           level. Depends on the volume hook still firing in this mode --
#           verify with `make volume-test`.
# "no"   -> fallback if the hook doesn't fire. See docs/TUNING.md.
IGNORE_VOLUME_CONTROL="yes"

# ---------------------------------------------------------------------------
# Web GUI
# ---------------------------------------------------------------------------
GUI_PORT=5005
# 0.0.0.0 exposes it on the LAN with no auth. 127.0.0.1 to require an SSH tunnel.
GUI_BIND="0.0.0.0"
