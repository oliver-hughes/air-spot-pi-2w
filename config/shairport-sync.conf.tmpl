// ---------------------------------------------------------------------------
// GENERATED by air-spot-pi-2w bootstrap. Local edits will be overwritten.
// Change config/shairport-sync.conf.tmpl in the repo instead.
//
// Written against shairport-sync 5.x, which renamed several settings from 4.x.
// ---------------------------------------------------------------------------

general = {
    name = "@AIRPLAY_NAME@";

    output_backend = "alsa";

    // "auto" picks by CPU. On a Zero 2 W that should land on "vernier", which
    // is the low-power option. If you see sync complaints in the journal,
    // pin it to "vernier" explicitly rather than "soxr" -- soxr assumes a
    // fast processor we do not have.
    interpolation = "auto";

    // --- Volume -----------------------------------------------------------
    // All attenuation happens in CamillaDSP, not here. Two reasons:
    //   1. Attenuating in both places would double-apply.
    //   2. The Loudness filter needs the fader to reflect the real listening
    //      level, so CamillaDSP has to own the volume.
    //
    // This is the setting flagged as unresolved in DESIGN.md 8 -- specifically
    // whether run_this_when_volume_is_set still fires with this set to "yes".
    // If it does not, set this to "no" and see docs/TUNING.md for the fallback.
    // Verify with:  journalctl -t air-spot-vol -f   then move the phone slider.
    ignore_volume_control = "@IGNORE_VOLUME_CONTROL@";

    volume_range_db = 60;

    // The AirPlay volume is appended to this command as its last argument.
    run_this_when_volume_is_set = "/usr/local/bin/air-spot-vol-bridge";

    // shairport-sync's own single-shelf loudness. Off -- CamillaDSP's is the
    // customisable one, and running both would fight.
    loudness_enabled = "no";
};

alsa = {
    // The loopback, not the DAC. CamillaDSP sits between the two.
    output_device = "hw:Loopback,0,0";

    // Pinned, not negotiated. The ALSA Loopback adopts the rate and format of
    // whichever application opens it first, so shairport-sync and CamillaDSP
    // must be configured to agree. Both come from OUTPUT_RATE / OUTPUT_FORMAT
    // in config/settings.env.
    //
    // 48000 so the AirPlay 2 lossless tier (ALAC/S24/48000) passes through
    // without being downsampled. shairport-sync transcodes the 44.1 tiers up
    // to match. S32 carries the 24-bit content without truncation.
    output_rate = @OUTPUT_RATE@;
    output_format = "@OUTPUT_FORMAT@";

    // No hardware mixer on a loopback. Leave synchronisation on: it is how
    // shairport-sync keeps AirPlay 2 multi-room timing honest.
    disable_synchronization = "no";
};

diagnostics = {
    log_verbosity = 0;
};
